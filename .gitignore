# Ignore Quarto build artifacts and local-only caches (do not publish)
_book/
_freeze/
.jupyter_cache/
.posit/
_quarto_cache/
.quarto/

# Ignore Python virtual environments (uv, venv, etc.)
.venv/
venv/
env/

# Ignore Python bytecode
__pycache__/
*.pyc

# Ignore Jupyter/Quarto temp files
.ipynb_checkpoints/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore Positron temporary files
.vscode/
.positron/

# Ignore logs
*.log

/.quarto/

**/*.quarto_ipynb

# LaTeX / PDF build outputs (local only)
index.tex
index.aux
index.log
index.toc
*.aux
*.toc
